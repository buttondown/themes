{
    "$schema": "../theme.schema.json",
    "name": "Arbus",
    "description": "An Instagram-inspired grid theme displaying posts in a three-column layout, perfect for image-heavy newsletters.",
    "version": "1.0.0",
    "configuration": {
        "posts_per_page": {
            "type": "number",
            "default": 21,
            "header": "Posts per page",
            "description": "Number of posts to display per page"
        },
        "dark_mode": {
            "type": "boolean",
            "default": false,
            "header": "Dark mode",
            "description": "Match your reader's system dark mode preference"
        },
        "show_latest_issue_link": {
            "type": "boolean",
            "default": false,
            "header": "Latest issue link",
            "description": "Link to your most recent published issue from the subscribe page (only shown when your archive is public)"
        },
        "color-accent": {
            "type": "color",
            "default": "#0069FF",
            "header": "Accent color",
            "description": "Primary accent color"
        },
        "color-accent-dark": {
            "type": "color",
            "default": "#4A9EFF",
            "header": "Accent color (dark mode)",
            "description": "Primary accent color for dark mode"
        },
        "font-body": {
            "type": "font",
            "default": "'Source Serif 4 Variable'",
            "header": "Body font",
            "description": "Font family for body text"
        },
        "font-accent": {
            "type": "font",
            "default": "Hex Franklin",
            "header": "Accent font",
            "description": "Font family for headings and accents"
        },
        "show-description": {
            "type": "boolean",
            "default": false,
            "header": "Show description?",
            "description": "Show the description of the post in the archive",
            "storageKey": "email-description-display",
            "storageValues": { "true": "block", "false": "none" }
        },
        "archive-column-count": {
            "type": "number",
            "default": 3,
            "header": "Column count",
            "description": "Number of columns to display in the archive"
        },
        "color-background": {
            "type": "color",
            "default": "#FAFAFA",
            "header": "Background color",
            "description": "Page background color"
        },
        "color-background-dark": {
            "type": "color",
            "default": "#1A1A1E",
            "header": "Background color (dark mode)",
            "description": "Page background color for dark mode"
        },
        "blockquote_style": {
            "type": "select",
            "default": "card",
            "header": "Blockquote style",
            "description": "Visual style for blockquote text",
            "options": [
                { "id": "card", "label": "Card" },
                { "id": "bar", "label": "Bar" },
                { "id": "editorial", "label": "Editorial" }
            ]
        },
        "post_navigation": {
            "type": "boolean",
            "default": true,
            "header": "Post navigation",
            "description": "Show links to the previous and next post at the foot of each archived post"
        }
    }
}
