{
    "$schema": "../theme.schema.json",
    "name": "Arbus",
    "description": "An Instagram-inspired grid theme displaying posts in a three-column layout, perfect for image-heavy newsletters.",
    "version": "1.0.0",
    "configuration": {
        "posts_per_page": {
            "type": "number",
            "default": 21,
            "header": "Posts per page",
            "description": "Number of posts to display per page"
        },
        "dark_mode": {
            "type": "boolean",
            "default": false,
            "header": "Dark mode",
            "description": "Match your reader's system dark mode preference"
        },
        "color-accent": {
            "type": "color",
            "default": "#0069FF",
            "header": "Accent color",
            "description": "Primary accent color for light mode"
        },
        "color-accent-dark": {
            "type": "color",
            "default": "#4A9EFF",
            "header": "Accent color (dark mode)",
            "description": "Primary accent color for dark mode"
        },
        "font-body": {
            "type": "font",
            "default": "Source Serif 4",
            "header": "Body font",
            "description": "Font family for body text"
        },
        "font-accent": {
            "type": "font",
            "default": "Hex Franklin",
            "header": "Accent font",
            "description": "Font family for headings and accents"
        },
        "show-description": {
            "type": "boolean",
            "default": false,
            "header": "Show description?",
            "description": "Show the description of the post in the archive",
            "storageKey": "email-description-display",
            "storageValues": { "true": "block", "false": "none" }
        },
        "archive-column-count": {
            "type": "number",
            "default": 3,
            "header": "Column count",
            "description": "Number of columns to display in the archive"
        },
        "font-size-blockquote": {
            "type": "select",
            "default": "16px",
            "header": "Blockquote font size",
            "description": "Font size for blockquote text",
            "options": [
                { "id": "14px", "label": "Small" },
                { "id": "16px", "label": "Medium" },
                { "id": "20px", "label": "Large" }
            ]
        }
    }
}
