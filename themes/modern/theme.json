{
    "$schema": "../theme.schema.json",
    "name": "Modern",
    "description": "A contemporary theme featuring large images and a card-based layout ideal for visual newsletters.",
    "version": "1.0.0",
    "configuration": {
        "posts_per_page": {
            "type": "number",
            "default": 20,
            "header": "Posts per page",
            "description": "Number of posts to display per page"
        },
        "archive_index_layout": {
            "type": "select",
            "default": "single",
            "header": "Archive layout",
            "description": "Single column, a two-column grid on wide screens, or an image gallery",
            "options": [
                { "id": "single", "label": "Single column" },
                { "id": "grid", "label": "Two-column grid" },
                { "id": "gallery", "label": "Image gallery" }
            ]
        },
        "archive-column-count": {
            "type": "number",
            "default": 3,
            "min": 1,
            "max": 6,
            "header": "Gallery column count",
            "description": "Number of columns in the image gallery layout"
        },
        "show-description": {
            "type": "boolean",
            "default": true,
            "header": "Show description?",
            "description": "Show the description of each post in the archive",
            "storageKey": "email-description-display",
            "storageValues": { "true": "block", "false": "none" }
        },
        "dark_mode": {
            "type": "boolean",
            "default": false,
            "header": "Dark mode",
            "description": "Match your reader's system dark mode preference"
        },
        "show_latest_issue_link": {
            "type": "boolean",
            "default": false,
            "header": "Latest issue link",
            "description": "Link to your most recent published issue from the subscribe page (only shown when your archive is public)"
        },
        "color-accent": {
            "type": "color",
            "default": "#0069FF",
            "header": "Accent color",
            "description": "Primary accent color"
        },
        "color-accent-dark": {
            "type": "color",
            "default": "#4A9EFF",
            "header": "Accent color (dark mode)",
            "description": "Primary accent color for dark mode"
        },
        "font-body": {
            "type": "font",
            "default": "'Source Serif 4 Variable'",
            "header": "Body font",
            "description": "Font family for body text"
        },
        "font-accent": {
            "type": "font",
            "default": "Hex Franklin",
            "header": "Accent font",
            "description": "Font family for headings and accents"
        },
        "color-background": {
            "type": "color",
            "default": "#FAFAFA",
            "header": "Background",
            "description": "Page background color and pattern"
        },
        "color-background-dark": {
            "type": "color",
            "default": "#1A1A1E",
            "header": "Background color (dark mode)",
            "description": "Page background color for dark mode"
        },
        "color-pattern": {
            "type": "color",
            "default": "#DCE6F7",
            "header": "Pattern color",
            "description": "Color of the background pattern"
        },
        "color-pattern-dark": {
            "type": "color",
            "default": "#26303F",
            "header": "Pattern color (dark mode)",
            "description": "Color of the background pattern for dark mode"
        },
        "background_pattern": {
            "type": "select",
            "default": "none",
            "header": "Background pattern",
            "description": "Add a geometric design to the background of your pages.",
            "options": [
                { "id": "none", "label": "None" },
                { "id": "chevron", "label": "Chevron" },
                { "id": "circles", "label": "Circles" },
                { "id": "graph", "label": "Graph paper" },
                { "id": "grid", "label": "Grid" },
                { "id": "hive", "label": "Hive" },
                { "id": "dots", "label": "Polka dots" },
                { "id": "ramen", "label": "Ramen" },
                { "id": "scanner", "label": "Scanner" }
            ]
        },
        "color-content-background": {
            "type": "color",
            "default": "#FFFFFF00",
            "header": "Content",
            "description": "Background color, border color, and border width of the content area on posts and similar pages. Lower the opacity to let the page background show through."
        },
        "color-content-background-dark": {
            "type": "color",
            "default": "#23232800",
            "header": "Content color (dark mode)",
            "description": "Background color of the content area for dark mode"
        },
        "color-content-border": {
            "type": "color",
            "default": "#E4E4E700",
            "header": "Content border color",
            "description": "Border color of the content area"
        },
        "color-content-border-dark": {
            "type": "color",
            "default": "#3A3A4000",
            "header": "Content border color (dark mode)",
            "description": "Border color of the content area for dark mode"
        },
        "content-border-width": {
            "type": "number",
            "default": 1,
            "min": 0,
            "max": 8,
            "header": "Content border width",
            "description": "Border width of the content area, in pixels"
        },
        "blockquote_style": {
            "type": "select",
            "default": "card",
            "header": "Blockquote style",
            "description": "Visual style for blockquote text",
            "options": [
                { "id": "card", "label": "Card" },
                { "id": "bar", "label": "Bar" },
                { "id": "editorial", "label": "Editorial" }
            ]
        },
        "post_navigation": {
            "type": "boolean",
            "default": true,
            "header": "Post navigation",
            "description": "Show links to the previous and next post at the foot of each archived post"
        }
    }
}
